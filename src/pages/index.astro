---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialRail from "../components/SocialRail.astro";
import TerminalPanel from "../components/TerminalPanel.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Pooya Sharifi — Software Developer"
  description="Software developer with frontend experience, studying cybersecurity and learning DevOps."
  current="home"
>
  <main class="landing">
    <SocialRail />

    <section class="hero-copy" aria-labelledby="hero-title">
      <p class="eyebrow">Hi, I’m <strong>Pooya.</strong></p>

      <h1 id="hero-title">
        I build thoughtful
        <br />
        software for the web<span>.</span>
      </h1>

      <p class="hero-summary">
        Software developer with frontend experience, studying cybersecurity at
        master’s level and learning DevOps to build secure, reliable systems.
      </p>

      <ul class="profile-facts" aria-label="Profile details">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s7-6.2 7-12A7 7 0 1 0 5 9c0 5.8 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"></path>
          </svg>
          Turin, Italy
        </li>

        <li>
          <span class="status-dot" aria-hidden="true"></span>
          Open to opportunities
        </li>

        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m2 9 10-5 10 5-10 5L2 9Zm4 3.2V17l6 3 6-3v-4.8l-6 3-6-3Z"></path>
          </svg>
          M.Sc. Cybersecurity Student
        </li>
      </ul>

      <div class="hero-actions">
        <a class="button button--primary" href={`${base}cv/`}>
          View CV
          <span aria-hidden="true">→</span>
        </a>

        <a class="button button--text" href={`${base}blog/`}>
          Read Blog
        </a>
      </div>
    </section>

    <TerminalPanel />
  </main>
</BaseLayout>
