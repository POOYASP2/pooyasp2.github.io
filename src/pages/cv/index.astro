---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/cv.css";

const experience = [
  {
    date: "04/2023 – Present",
    title: "Frontend Developer, Part-time | VPnetwork Canada Ltd",
    location: "Canada – Remote",
    description:
      "Developed a financial website with React, Sass, and WordPress, refactored to React v18, and integrated a custom design system for consistency."
  },
  {
    date: "01/2023 – 03/2023",
    title: "Frontend Developer, Ravi",
    location: "Iran",
    description:
      "Built a responsive e-commerce PWA for hotel supplies with Next.js and Chakra UI, featuring a custom design system."
  },
  {
    date: "09/2022 – 11/2022",
    title: "Frontend Developer, ParsTech AI",
    location: "Iran",
    description:
      "Built and deployed a CRM with Quasar, Vue, and Sass, integrating data visualization and automating deployment and testing with GitLab and Cypress."
  },
  {
    date: "12/2020 – 06/2022",
    title: "Frontend Developer, Hiprofit",
    location: "Iran",
    description:
      "Developed an e-commerce platform for audiologists using Quasar, Vue, Sass, GitLab Runner, Liara-cli, and Sentry.io for streamlined deployment and error monitoring."
  }
];

const education = [
  {
    date: "09/2016 – 11/2021",
    title: "B.Sc. in Computer Engineering",
    subtitle: "Sadjad University of Technology",
    location: "Mashhad, Iran"
  },
  {
    date: "2023 – 2025",
    title: "M.Sc. in Cybersecurity",
    subtitle: "University of Turin, Italy",
    location: "Turin, Italy",
    description: "Focus on Cloud Security, Cryptography and Secure System Design."
  },
  {
    date: "2018 – 2022",
    title: "B.Sc. in Computer Engineering",
    subtitle: "University of Isfahan, Iran",
    location: "Isfahan, Iran",
    description: "Courses: Data Structures, Algorithms, OS, Networks, Databases."
  }
];

const projects = [
  {
    date: "10/2023 – 01/2024",
    title: "Sanachange Exchange",
    description:
      "Developed with Vue 3, this cryptocurrency exchange includes referral-code management, secure wallet handling, seamless deposits and withdrawals, and support for trading 240 cryptocurrencies."
  },
  {
    date: "2021",
    title: "Analysis of Smartest Overloads Data",
    description:
      "A two-person analysis of stress-related train data using Pandas, NumPy, Scikit-learn, and GeoPandas to extract meaningful insights and identify patterns in train stress levels."
  },
  {
    date: "2021",
    title: "Analysis of UK Traffic Accident Data and Severity Prediction",
    description:
      "Analyzed traffic accident statistics with Pandas, applied correlation analysis and data-science techniques, and used statistical and machine-learning approaches to predict accident severity."
  }
];
---

<BaseLayout
  title="CV — Pooya Sharifi"
  description="Curriculum vitae, experience, education, projects, and skills of Pooya Sharifi."
  current="cv"
>
  <main class="cv-page">
    <aside class="cv-sidebar">
      <header class="cv-heading">
        <p>/CV</p>
        <h1>Curriculum<br />Vitae<span>.</span></h1>
        <p>Computer Programmer<br />Cybersecurity Enthusiast</p>
      </header>

      <section class="cv-contact" aria-label="Contact details">
        <p><span>⌖</span> Turin, Italy</p>
        <p><span>✉</span> pooyasharifi.sp2@gmail.com</p>
        <p><span>⌕</span> +39 352 013 7714</p>
        <p><span>▣</span> +98 915 052 7185</p>
        <p><span>in</span> linkedin.com/in/pooya-sharifi</p>
        <p><span>●</span> github.com/POOYASP2</p>
      </section>

      <section class="cv-side-section">
        <h2>/SKILLS</h2>
        <h3>‹/› <span>Languages</span></h3>
        <p>JavaScript, Python, C, C++, Matlab, Bash, PHP</p>
        <h3>◇ <span>Tools &amp; Technologies</span></h3>
        <p>Docker, Pytorch, Sklearn, Git, Vue.js (2 &amp; 3), Pandas, Numpy, SQL, React, VSCode, Wireshark, Burp Suite.</p>
        <h3>⚙ <span>Other</span></h3>
        <p>Linux, OWASP Web Vulnerabilities, Agile Methodologies, API Design &amp; Development</p>
        <h3>◎ <span>Soft Skills</span></h3>
        <p>Adaptability, Critical thinking, Communication, Teamwork, Time management</p>
      </section>

      <section class="cv-side-section">
        <h2>/CERTIFICATES</h2>
        <ul><li>OWASP</li><li>Python Intermediate</li><li>C</li><li>PHP</li></ul>
      </section>

      <section class="cv-side-section">
        <h2>/LANGUAGES</h2>
        <p>English<br />TOEFL Total Score 97 – C1</p>
        <div class="language-meter"><span></span></div>
      </section>

      <section class="cv-side-section">
        <h2>/AWARDS</h2>
        <p>🏆 AIChallenge 2020, Sharif University of Technology</p>
        <small>Qualified as a team for the final round by developing a reinforcement learning agent to maximize game scores.</small>
      </section>

      <section class="cv-side-section cv-interests">
        <h2>/INTERESTS</h2>
        <div><span>◉<small>AI / ML</small></span><span>⬡<small>Cybersecurity</small></span><span>◯<small>Open Source</small></span><span>▤<small>Reading</small></span></div>
      </section>
    </aside>

    <div class="cv-main">
      <section class="cv-profile">
        <header class="terminal-bar">
          <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
        </header>
        <div>
          <p class="command"><span>$</span> whoami</p>
          <p>Pooya Sharifi</p>
          <p><strong>Programmer</strong> | Problem Solver | Lifelong Learner</p>
          <p>I build scalable, secure and reliable systems.</p>
          <p class="command"><span>$</span> <i></i></p>
        </div>
      </section>

      <section class="cv-main-section">
        <h2>/EXPERIENCE</h2>
        <div class="cv-timeline">
          {experience.map((item) => (
            <article class="cv-entry">
              <time>{item.date}</time>
              <span class="cv-node" aria-hidden="true"></span>
              <div>
                <h3>{item.title} <span>↗</span></h3>
                <p>{item.description}</p>
              </div>
              <small>{item.location}</small>
            </article>
          ))}
        </div>
      </section>

      <section class="cv-main-section">
        <h2>/EDUCATION</h2>
        <div class="cv-timeline">
          {education.map((item) => (
            <article class="cv-entry">
              <time>{item.date}</time>
              <span class="cv-node" aria-hidden="true"></span>
              <div>
                <h3>{item.title}</h3>
                <p class="cv-subtitle">{item.subtitle} <span>↗</span></p>
                {item.description && <p>{item.description}</p>}
              </div>
              <small>{item.location}</small>
            </article>
          ))}
        </div>
      </section>

      <section class="cv-main-section">
        <h2>/PROJECTS</h2>
        <div class="cv-timeline">
          {projects.map((item) => (
            <article class="cv-entry cv-entry--project">
              <time>{item.date}</time>
              <span class="cv-node" aria-hidden="true"></span>
              <div>
                <h3>{item.title} <span>↗</span></h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="cv-bottom-grid">
        <section class="cv-main-section">
          <h2>/COURSES</h2>
          <article class="cv-compact-entry"><time>2022</time><div><h3>OWASP Application Security Workshop</h3><p>Seven-week workshop covering OWASP Top Ten vulnerabilities, secure coding practices, and mitigation strategies.</p></div></article>
          <article class="cv-compact-entry"><time>2021</time><div><h3>Pytorch Event Course</h3><p>Intensive deep-learning course with PyTorch, neural networks, CNNs, and Autoencoders.</p></div></article>
        </section>

        <section class="cv-main-section">
          <h2>/VOLUNTEERING</h2>
          <article class="cv-compact-entry"><time>2016 – 2020</time><div><h3>Sadjad IO</h3><p>Organized workshops and competitions, collaborated with private academies, and facilitated industry networking.</p></div></article>
          <article class="cv-compact-entry"><time>2018</time><div><h3>Startup Weekend (Tourism Industry)</h3><p>Executive Team Member.</p></div></article>
          <article class="cv-compact-entry"><time>2017</time><div><h3>Startup Weekend (Food Industry)</h3><p>Executive Team Member.</p></div></article>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
